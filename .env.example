APP_NAME="Chez Ketchup"
# Utiliser production avant ouverture publique.
# En production, les mots de passe demo et le code livreur par defaut sont refuses.
APP_ENV=local
APP_URL=http://localhost/boucherketchup

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chez_ketchup
DB_USERNAME=root
DB_PASSWORD=

ADMIN_EMAIL=admin@chezketchup.com
ADMIN_PASSWORD=ChangeMe123!
SESSION_TTL_HOURS=12
AUTH_MAX_ATTEMPTS=5
AUTH_LOCK_MINUTES=15

# Code attribue aux livreurs existants lors de la premiere migration
DELIVERY_DEFAULT_CODE=1234

# Notifications: manual, webhook, twilio, meta
NOTIFICATION_PROVIDER=manual
NOTIFICATION_WEBHOOK_URL=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

META_WHATSAPP_API_VERSION=v19.0
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=
